{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "6.8"
	},
	"features": {
		"networking": true
	},
	"extraLibraries": [
		"wp-cli"
	],
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"SCRIPT_DEBUG": true
			}
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/mu-plugins"
		},
		{
			"step": "cp",
			"fromPath": "/wordpress/wp-content/plugins/publication-checklist/tests/fixtures/mu-plugin-live-checks.php",
			"toPath": "/wordpress/wp-content/mu-plugins/live-checks-fixture.php"
		},
		{
			"step": "wp-cli",
			"command": "wp rewrite flush"
		},
		{
			"step": "login"
		}
	]
}
